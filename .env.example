# Frame sequence pipeline (scroll-scrub)
# Generate a Sanity API token with Editor permissions at sanity.io/manage
SANITY_API_WRITE_TOKEN=

# Public site URL — used for Open Graph link previews (e.g. https://birdseye.golf)
NEXT_PUBLIC_SITE_URL=

# Mux webhook signing secret — https://dashboard.mux.com/settings/webhooks
MUX_WEBHOOK_SECRET=

# --- Client onboarding & billing ---

# Postgres connection (Supabase or Neon)
# On Windows, use Supabase "Transaction pooler" URI (port 6543) from Connect.
# Session pooler (port 5432) has low connection limits and can fail in Next.js dev.
# Run migrations: psql $DATABASE_URL -f lib/db/migrations/0000_init.sql
# Or: npm run db:push
DATABASE_URL=

# Admin dashboard (/admin/login) — use a long random string for ADMIN_SESSION_SECRET
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=
ADMIN_ALLOWED_EMAILS=you@example.com

# Stripe — https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_9_MONTHLY=
STRIPE_PRICE_9_ANNUAL=
STRIPE_PRICE_18_MONTHLY=
STRIPE_PRICE_18_ANNUAL=
STRIPE_PRICE_27_MONTHLY=
STRIPE_PRICE_27_ANNUAL=

# DocuSign — JWT auth + generated Word contracts (or legacy template merge fields)
# DOCUSIGN_ENV=demo
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_TEMPLATE_ID=
# DOCUSIGN_CLIENT_ROLE_NAME=Client
# DOCUSIGN_RSA_PRIVATE_KEY=
# DOCUSIGN_WEBHOOK_HMAC_KEY=
# Directory of variant .docx files (base / travel / trade_out / travel_trade_out).
# Build them with: npm run build:contract-variants
# DOCUSIGN_CONTRACT_DOCX_DIR=docs/legal/contracts
# DOCUSIGN_ENVELOPE_MODE=generated
# Connect webhook URL: https://your-domain.com/api/docusign/webhook

# Manual payment instructions shown to cash/check clients during onboarding
MANUAL_PAYMENT_INSTRUCTIONS=If paying by check, please make check payable to Birdseye Golf. Checks can be mailed to:\nBirdseye Golf\n625 N Cherry Creek Pkwy\nRichmond, UT 84333

# Optional: User-Agent for OpenStreetMap geocoding (travel fee distance checks)
# GEOCODING_USER_AGENT=Birdseye Golf Onboarding/1.0 (you@example.com)

# Contact form + onboarding emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Optional: HTTP endpoint that runs frame extraction (Railway/Fly worker)
# FRAME_EXTRACTOR_URL=https://your-worker.example.com/extract
# FRAME_EXTRACTOR_SECRET=

# Dev: auto-run ffmpeg extraction when Mux webhook fires (requires MUX_WEBHOOK_SECRET + ngrok/tunnel)
# FRAME_EXTRACTOR_RUN_LOCAL=1

# Local frame extraction — run after uploading/replacing videos in Studio:
#   npm run extract-pending

# Local frame extraction (scripts/extract-frames.mjs)
# ~4 frames/sec of footage — shorter par 3 clips get fewer frames, par 5 get more
# FRAMES_SAMPLE_FPS=4
# FRAMES_MIN_FRAMES=40
# FRAMES_MAX_FRAMES=150
# FRAMES_MAX_WIDTH=1280
# FRAMES_WEBP_QUALITY=78
# FRAMES_FORMAT=webp
# FRAMES_OUTPUT_DIR=public/frames
# FRAMES_PUBLIC_BASE_URL=/frames

# Dev: auto-try /frames/{playbackId}/manifest.json when Sanity has no frames yet
# NEXT_PUBLIC_FRAMES_DEV_AUTO=1
