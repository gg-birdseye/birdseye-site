{
  "name": "birdseye",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "npm run clean && npm run dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "db:push": "drizzle-kit push",
    "extract-frames": "node --env-file=.env.local scripts/extract-frames.mjs",
    "extract-pending": "node --env-file=.env.local scripts/extract-pending-flyovers.mjs",
    "extract-pending:patch": "node --env-file=.env.local scripts/extract-pending-flyovers.mjs --patch-sanity",
    "list-flyovers": "node --env-file=.env.local scripts/list-flyovers.mjs",
    "fix-broken-flyovers": "node --env-file=.env.local scripts/fix-broken-flyovers.mjs",
    "extract-intro": "node --env-file=.env.local scripts/extract-frames.mjs --playback-id introvid --input public/introvid.mp4 --sample-fps 12",
    "verify-docusign": "node scripts/verify-docusign-setup.mjs",
    "docusign:cleanup-tabs": "node scripts/docusign-cleanup-template-tabs.mjs",
    "docusign:fix-template": "node scripts/docusign-fix-template-via-envelope.mjs && npm run verify-docusign",
    "docusign:bootstrap-template": "node scripts/docusign-bootstrap-template-api.mjs && npm run verify-docusign",
    "docusign:visual-test": "node scripts/docusign-visual-test.mjs",
    "docusign:generated-test": "node scripts/docusign-generated-document-test.mjs",
    "generate:contract-docx": "node scripts/generate-birdseye-msa-docx.mjs",
    "build:contract-variants": "node scripts/build-contract-variants.mjs"
  },
  "dependencies": {
    "@mux/upchunk": "^3.4.0",
    "@next/third-parties": "^16.2.6",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.24.0",
    "adm-zip": "^0.5.17",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "hls.js": "^1.6.16",
    "iron-session": "^8.0.4",
    "lottie-react": "^2.4.1",
    "next": "^16.2.6",
    "next-sanity": "^12.4.5",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "resend": "^6.12.4",
    "sanity": "^5.24.0",
    "sanity-plugin-mux-input": "^2.19.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.2.2",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
